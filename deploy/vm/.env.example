# Copy to .env (install.sh does this and fills the secrets). Never commit .env; keep it chmod 600.
# Comments must stay on their own lines: docker compose reads "KEY=   # text" as the value "# text".

# DNS A record must point at this VM before first start.
DOMAIN=cash.example.in
# An Indian region name, e.g. ap-south-1, ap-south-2, centralindia, asia-south1. The API refuses to start otherwise.
DEPLOY_REGION=ap-south-1

# Generated by install.sh. Do not leave these empty or edit them after first start (changing POSTGRES_PASSWORD needs an ALTER ROLE too).
POSTGRES_PASSWORD=
JWT_SECRET=
# Generated by install.sh. Keep a copy OFF this machine: without it backups cannot be restored.
BACKUP_PASSPHRASE=
BACKUP_KEEP_DAYS=14
# 20:00 UTC = 01:30 IST
BACKUP_HOUR_UTC=20

# Optional. Hosts the app may call out to (FX feed, SFTP, IMAP, ERP webhook), comma separated.
ALLOWED_EGRESS_HOSTS=
FX_FEED_URL=
# Only for the LLM fallback in remittance extraction. Setting it sends advice text to the vendor, outside India.
ANTHROPIC_API_KEY=
# Single sign-on (OIDC) and SCIM. Leave empty to use local passwords.
SSO_ISSUER=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_REDIRECT_URI=
SSO_ROLE_MAP=
SCIM_TOKEN=
